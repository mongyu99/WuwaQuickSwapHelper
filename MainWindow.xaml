<Window x:Class="WuwaQuickSwapHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WuwaQuickSwapHelper.Converters"
        Title="WuwaQuickSwapHelper"
        Width="560"
        Height="260"
        MinWidth="260"
        MinHeight="140"
        ResizeMode="CanResizeWithGrip"
		WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
		Topmost="True"
        ShowInTaskbar="True"
		MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- 현재 입력 키 크기 -->
        <conv:CurrentSizeConverter x:Key="CurrentSizeConverter"/>
        <!-- 현재 입력 키 배경 -->
        <conv:CurrentBackgroundConverter x:Key="CurrentBackgroundConverter"/>
		<conv:CurrentBackgroundConverter x:Key="BackgroundConverter"/>
		<conv:CurrentSizeConverter x:Key="SizeConverter"/>
    </Window.Resources>

    <Grid>

    <!-- 창 배경 (오른쪽 아래 모서리를 끌어 크기 조절) -->
    <Border x:Name="RootBorder" Background="#E61E1E1E" BorderBrush="#555555" BorderThickness="1" CornerRadius="10">

    <Grid Margin="8">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- 왼쪽 위: 메뉴로 돌아가기 (진행 화면에서만 표시) -->
		<Button x:Name="MenuButton" Grid.Row="0" Height="24" MinWidth="50" Padding="6,0" Margin="0,0,0,6" HorizontalAlignment="Left" Visibility="Collapsed" Content="← 메뉴" Click="MenuButton_Click"/>

		<!-- 오른쪽 위 버튼: 목록 / 고정 / 투명도 / 종료 -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
			<Button x:Name="LockButton" Height="24" MinWidth="50" Padding="6,0" Content="고정" ToolTip="고정하면 클릭이 창을 통과합니다. 해제: F10" Click="LockButton_Click"/>
			<Button x:Name="OpacityButton" Height="24" MinWidth="50" Padding="6,0" Margin="4,0,0,0" Content="불투명" ToolTip="클릭: 불투명 → 반투명 → 투명" Click="OpacityButton_Click"/>
			<Button Height="24" MinWidth="50" Padding="6,0" Margin="4,0,0,0" Content="종료" Click="ExitButton_Click"/>
		</StackPanel>

		<!-- 투명도 조절 대상 -->
		<Grid x:Name="ContentRoot" Grid.Row="1">

		<!-- 시작 메뉴 -->
		<Border x:Name="StartMenu" Background="#DD1E1E1E" CornerRadius="10" Padding="16" HorizontalAlignment="Left" VerticalAlignment="Top">
			<StackPanel>
				<Button Width="160" Height="36" Content="사이클 시작" Click="StartButton_Click"/>
				<Button Width="160" Height="30" Margin="0,8,0,0" Content="코드 입력" Click="ImportMenuButton_Click"/>
				<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
					<Button Width="76" Height="30" Content="내보내기" ToolTip="Data 폴더의 콤보 전체를 JSON 파일 하나로 저장합니다. (서명 없음)" Click="ExportButton_Click"/>
					<Button Width="76" Height="30" Margin="8,0,0,0" Content="받기" ToolTip="API 키로 웹사이트에서 콤보를 받아옵니다." Click="ReceiveMenuButton_Click"/>
				</StackPanel>
			</StackPanel>
		</Border>

		<!-- 코드 입력: JSON 붙여넣기 -->
		<Border x:Name="ImportView" Visibility="Collapsed" Background="#DD1E1E1E" CornerRadius="10" Padding="12" VerticalAlignment="Top">
			<StackPanel>
				<TextBlock Text="코드 입력 (JSON 붙여넣기)" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
				<TextBox x:Name="ImportTextBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
				<StackPanel Orientation="Horizontal" Margin="0,6,0,0">
					<Button Width="70" Height="26" Content="저장" Click="ImportSaveButton_Click"/>
					<TextBlock x:Name="ImportStatusText" Foreground="#AAAAAA" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
				</StackPanel>
			</StackPanel>
		</Border>

		<!-- 받기: API 키로 웹사이트에서 받아오기 -->
		<Border x:Name="ReceiveView" Visibility="Collapsed" Background="#DD1E1E1E" CornerRadius="10" Padding="12" HorizontalAlignment="Left" VerticalAlignment="Top">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="220"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<TextBlock Grid.ColumnSpan="2" Text="받기" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
				<TextBlock Grid.Row="1" Text="API 키" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,4"/>
				<PasswordBox x:Name="ApiKeyBox" Grid.Row="1" Grid.Column="1" Height="24" Margin="0,0,0,4"/>
				<TextBlock Grid.Row="2" Text="코드" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,4"/>
				<TextBox x:Name="ReceiveCodeBox" Grid.Row="2" Grid.Column="1" Height="24" Margin="0,0,0,4" ToolTip="비워 두면 내 콤보 전체를 받습니다."/>
				<StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
					<Button x:Name="ReceiveButton" Width="70" Height="26" Content="받기" Click="ReceiveButton_Click"/>
					<TextBlock x:Name="ReceiveStatusText" Foreground="#AAAAAA" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- 사이클 진행 화면 -->
		<Grid x:Name="CycleView" Visibility="Collapsed">

		<Grid.RenderTransform>
			<TranslateTransform x:Name="ShakeTransform"/>
		</Grid.RenderTransform>


		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="10"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>


		<!-- 현재 입력 -->
		<StackPanel Grid.Row="0">

            <TextBlock
				Text="{Binding Text}"
				FontSize="{Binding State, Converter={StaticResource CurrentSizeConverter}}"
				FontWeight="Bold"/>


			<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
				<!-- 사이클 멈춤 / 시작 -->
				<Button x:Name="PauseButton" Width="90" Height="28" Content="⏸ 멈춤" Click="PauseButton_Click"/>

				<!-- 체크리스트 (보기 옵션) -->
				<StackPanel x:Name="OptionChecklist" Margin="12,0,0,0" VerticalAlignment="Center">
					<CheckBox x:Name="ShowNextLinesCheckBox" Content="다음 3줄 한번에 보기" Foreground="White" FontSize="12"
							  ToolTip="현재 사이클이 끝난 뒤 이어질 사이클 2줄을 미리 보여줍니다."
							  Checked="ShowNextLinesCheckBox_Changed" Unchecked="ShowNextLinesCheckBox_Changed"/>
				</StackPanel>
			</StackPanel>
			
        </StackPanel>



		<!-- 다음 입력 리스트 -->
		<ItemsControl
			x:Name="NextInputList"
			Grid.Row="2">


			<ItemsControl.ItemsPanel>

				<ItemsPanelTemplate>
					<StackPanel Orientation="Horizontal"/>
				</ItemsPanelTemplate>

			</ItemsControl.ItemsPanel>



			<ItemsControl.ItemTemplate>

                <DataTemplate>

					<Border
							Background="{Binding State, Converter={StaticResource BackgroundConverter}}"
							CornerRadius="6"
							Margin="5"
							Padding="10">

						<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
							<!-- 반복 시작 지점 표시 -->
							<TextBlock Text="↻ " Foreground="#FFD54F" FontWeight="Bold" VerticalAlignment="Center">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsLoopStart}" Value="True">
												<Setter Property="Visibility" Value="Visible"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
							<TextBlock
								Text="{Binding Text}"
								FontSize="{Binding State, Converter={StaticResource SizeConverter}}"
								Foreground="White"
								FontWeight="Bold"
								VerticalAlignment="Center"/>
						</StackPanel>

					</Border>

                </DataTemplate>

            </ItemsControl.ItemTemplate>


		</ItemsControl>

		<!-- 다음 사이클 미리보기 (다음 3줄 한번에 보기) -->
		<ItemsControl x:Name="PreviewLines" Grid.Row="3" Visibility="Collapsed" Opacity="0.55" Margin="0,2,0,0">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<!-- 한 줄 = 다음에 이어질 사이클 하나 -->
					<ItemsControl ItemsSource="{Binding}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Background="#555555" CornerRadius="5" Margin="5,3" Padding="8,4" MinWidth="28">
									<TextBlock Text="{Binding}" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		</Grid>

		</Grid>

		<!-- 사이클 파일 목록 버튼 (종료 버튼 아래) -->
		<Grid Grid.Row="1">
			<Button x:Name="CycleListButton" Height="24" MinWidth="50" Padding="6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Content="☰ 목록" ToolTip="사이클 파일 목록 열기 / 닫기" Click="CycleListButton_Click"/>

		</Grid>

	</Grid>

    </Border>


    <!-- 사이클 파일 목록: 창 오른쪽 바깥에 창 높이만큼 슬라이드되어 나타납니다 -->
    <Popup x:Name="CycleFlyoutPopup" PlacementTarget="{Binding ElementName=RootBorder}" Placement="Right"
           AllowsTransparency="True" StaysOpen="True">
        <Grid Width="324" Height="{Binding ActualHeight, ElementName=RootBorder}" ClipToBounds="True">
		<Border x:Name="CycleFlyout" Width="320" Margin="4,0,0,0" HorizontalAlignment="Left"
				Background="#F2252526" BorderBrush="#555555" BorderThickness="1" CornerRadius="8" Padding="8">
			<Border.RenderTransform>
				<TranslateTransform x:Name="CycleFlyoutTransform" X="-330"/>
			</Border.RenderTransform>
			<DockPanel>
				<!-- 헤더 -->
				<Grid DockPanel.Dock="Top" Margin="4,0,4,4">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="4*"/>
						<ColumnDefinition Width="4*"/>
						<ColumnDefinition Width="3*"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="이름" Foreground="#AAAAAA" FontSize="12" FontWeight="Bold"/>
					<TextBlock Grid.Column="1" Text="사용 캐릭터" Foreground="#AAAAAA" FontSize="12" FontWeight="Bold"/>
					<TextBlock Grid.Column="2" Text="제작자" Foreground="#AAAAAA" FontSize="12" FontWeight="Bold"/>
				</Grid>
				<Border DockPanel.Dock="Top" Height="1" Background="#555555" Margin="0,0,0,4"/>

				<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
					<ItemsControl x:Name="CycleFileList">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Background="#30FFFFFF" CornerRadius="4" Padding="4,5" Margin="0,0,0,3" ToolTip="{Binding FilePath}">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="4*"/>
											<ColumnDefinition Width="4*"/>
											<ColumnDefinition Width="3*"/>
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
										<TextBlock Grid.Column="1" Text="{Binding Characters}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
										<TextBlock Grid.Column="2" Text="{Binding Author}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis"/>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</DockPanel>
		</Border>
        </Grid>
    </Popup>

    </Grid>

</Window>