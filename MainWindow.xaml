<Window x:Class="WuwaQuickSwapHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WuwaQuickSwapHelper.Converters"
        xmlns:models="clr-namespace:WuwaQuickSwapHelper.Models"
        Title="WuwaQuickSwapHelper"
        Width="560"
        Height="260"
        MinWidth="260"
        MinHeight="140"
        ResizeMode="CanResizeWithGrip"
		WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
		Topmost="True"
        ShowInTaskbar="True"
		MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- 현재 입력 키 크기 -->
        <conv:CurrentSizeConverter x:Key="CurrentSizeConverter"/>
        <!-- 현재 입력 키 배경 -->
        <conv:CurrentBackgroundConverter x:Key="CurrentBackgroundConverter"/>
		<conv:CurrentBackgroundConverter x:Key="BackgroundConverter"/>
		<conv:CurrentSizeConverter x:Key="SizeConverter"/>

		<!-- 콤보 한 칸 (현재 줄 / 미리보기 줄 공용) -->
		<DataTemplate x:Key="StepTemplate">
			<Border x:Name="StepBorder" Background="{DynamicResource StepBrush}" CornerRadius="6" Margin="3" MinWidth="44" Height="40" Padding="6,0">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
					<!-- 반복 시작 지점 표시 -->
					<TextBlock x:Name="LoopMark" Text="↻ " Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
					<TextBlock x:Name="StepText" Text="{Binding Text}" FontSize="16" LineHeight="20" LineStackingStrategy="BlockLineHeight"
							   Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
				</StackPanel>
			</Border>
			<DataTemplate.Triggers>
				<!-- 스왑 키(다음 줄로 넘어가는 키): 강조색 -->
				<DataTrigger Binding="{Binding State}" Value="{x:Static models:StepState.Current}">
					<Setter TargetName="StepBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
					<Setter TargetName="StepText" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
					<Setter TargetName="LoopMark" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding IsLoopStart}" Value="True">
					<Setter TargetName="LoopMark" Property="Visibility" Value="Visible"/>
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>
    </Window.Resources>

    <Grid>

    <!-- 창 배경 (오른쪽 아래 모서리를 끌어 크기 조절) -->
    <Border x:Name="RootBorder" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10">

    <Grid Margin="8">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- 왼쪽 위: 메뉴로 돌아가기 (진행 화면에서만 표시) -->
		<Button x:Name="MenuButton" Grid.Row="0" Style="{StaticResource IconButton}" Margin="0,0,0,6" HorizontalAlignment="Left" Visibility="Collapsed" Content="&#xE80F;" ToolTip="메뉴로 돌아가기" Click="MenuButton_Click"/>

		<!-- 오른쪽 위 버튼: 목록 / 고정 / 투명도 / 종료 -->
		<StackPanel x:Name="TopBar" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
			<Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Content="&#xE708;" ToolTip="라이트 모드로" Click="ThemeButton_Click"/>
			<Button x:Name="LockButton" Style="{StaticResource IconButton}" Margin="2,0,0,0" Content="&#xE718;" ToolTip="고정 (클릭이 창을 통과합니다. 해제: F10)" Click="LockButton_Click"/>
			<Button x:Name="OpacityButton" Style="{StaticResource IconButton}" Margin="2,0,0,0" Content="&#xE7B3;" ToolTip="투명도: 불투명 (클릭: 불투명 → 반투명 → 투명)" Click="OpacityButton_Click"/>
			<Button Style="{StaticResource IconButton}" Margin="2,0,0,0" Content="&#xE711;" ToolTip="종료" Click="ExitButton_Click"/>
		</StackPanel>

		<!-- 투명도 조절 대상 -->
		<Grid x:Name="ContentRoot" Grid.Row="1">

		<!-- 시작 메뉴 -->
		<Border x:Name="StartMenu" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16" HorizontalAlignment="Left" VerticalAlignment="Top">
			<StackPanel>
				<Button Width="168" Height="38" Click="StartButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE768;"/><TextBlock Text="사이클 시작" VerticalAlignment="Center"/></StackPanel></Button>
				<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
					<Button Width="80" Height="32" Click="NewCycleButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE710;"/><TextBlock Text="생성" VerticalAlignment="Center"/></StackPanel></Button>
					<Button Width="80" Height="32" Margin="8,0,0,0" Click="EditMenuButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE70F;"/><TextBlock Text="편집" VerticalAlignment="Center"/></StackPanel></Button>
				</StackPanel>
				<Button Width="168" Height="32" Margin="0,8,0,0" Click="ImportMenuButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE943;"/><TextBlock Text="코드 입력" VerticalAlignment="Center"/></StackPanel></Button>
				<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
					<Button Width="80" Height="32" ToolTip="Data 폴더의 콤보 전체를 JSON 파일 하나로 저장합니다. (서명 없음)" Click="ExportButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE898;"/><TextBlock Text="내보내기" VerticalAlignment="Center"/></StackPanel></Button>
					<Button Width="80" Height="32" Margin="8,0,0,0" ToolTip="API 키로 웹사이트에서 콤보를 받아옵니다." Click="ReceiveMenuButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE896;"/><TextBlock Text="받기" VerticalAlignment="Center"/></StackPanel></Button>
				</StackPanel>
			</StackPanel>
		</Border>

		<!-- 코드 입력: JSON 붙여넣기 -->
		<Border x:Name="ImportView" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" VerticalAlignment="Top">
			<StackPanel>
				<TextBlock Text="코드 입력 (JSON 붙여넣기)" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
				<TextBox x:Name="ImportTextBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
				<StackPanel Orientation="Horizontal" Margin="0,6,0,0">
					<Button Width="70" Height="26" Content="저장" Click="ImportSaveButton_Click"/>
					<TextBlock x:Name="ImportStatusText" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
				</StackPanel>
			</StackPanel>
		</Border>

		<!-- 사이클 편집: 편집할 파일 고르기 -->
		<Border x:Name="EditPickView" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12">
			<DockPanel>
				<TextBlock DockPanel.Dock="Top" Text="편집할 사이클 선택" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
				<TextBlock x:Name="EditPickEmptyText" DockPanel.Dock="Top" Text="Data 폴더에 사이클 파일이 없습니다. [사이클 생성]으로 만들어 주세요." Foreground="{DynamicResource SubTextBrush}" FontSize="12" Visibility="Collapsed"/>
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<ItemsControl x:Name="EditPickList">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="10,7" Margin="0,0,0,3" Cursor="Hand" ToolTip="{Binding FilePath}" MouseLeftButtonUp="CycleFileItem_Click">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="4*"/>
											<ColumnDefinition Width="4*"/>
											<ColumnDefinition Width="3*"/>
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
										<TextBlock Grid.Column="1" Text="{Binding Characters}" Foreground="{DynamicResource SubTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
										<TextBlock Grid.Column="2" Text="{Binding Author}" Foreground="{DynamicResource SubTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</DockPanel>
		</Border>

		<!-- 사이클 편집 -->
		<Border x:Name="EditView" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<Grid.Resources>
						<Style TargetType="TextBlock">
							<Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
							<Setter Property="FontSize" Value="12"/>
							<Setter Property="VerticalAlignment" Value="Center"/>
							<Setter Property="Margin" Value="0,0,8,4"/>
						</Style>
					</Grid.Resources>

					<TextBlock x:Name="EditTitleText" Grid.ColumnSpan="2" Text="사이클 편집" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>

					<TextBlock Grid.Row="1" Text="이름"/>
					<TextBox x:Name="EditNameBox" Grid.Row="1" Grid.Column="1" Height="22" Margin="0,0,0,4"/>

					<TextBlock Grid.Row="2" Text="사용 캐릭터"/>
					<TextBox x:Name="EditCharactersBox" Grid.Row="2" Grid.Column="1" Height="22" Margin="0,0,0,4" ToolTip="쉼표(,)로 구분, 최대 3명"/>

					<TextBlock Grid.Row="3" Text="제작자"/>
					<TextBox x:Name="EditAuthorBox" Grid.Row="3" Grid.Column="1" Height="22" Margin="0,0,0,4"/>

					<TextBlock Grid.Row="4" Text="단계" VerticalAlignment="Top" Margin="0,3,8,4"/>
					<StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,4">
						<TextBox x:Name="EditStepsBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"/>
						<TextBlock Text="키: Q E R 1 2 3 평타 SPACE  (공백으로 구분, 1~3 스왑 뒤에서 줄이 바뀝니다)" Foreground="{DynamicResource SubTextBrush}" FontSize="11" Margin="0,2,0,0"/>
					</StackPanel>

					<TextBlock Grid.Row="5" Text="반복 시작 줄"/>
					<TextBox x:Name="EditLoopLineBox" Grid.Row="5" Grid.Column="1" Width="50" Height="22" HorizontalAlignment="Left" Margin="0,0,0,4" ToolTip="0 = 반복 없음 (마지막 줄 다음 첫 줄로)"/>

					<StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
						<Button Width="60" Height="26" Content="저장" Click="EditSaveButton_Click"/>
						<Button Width="110" Height="26" Margin="6,0,0,0" Content="이 사이클로 시작" Click="EditStartButton_Click"/>
						<TextBlock x:Name="EditStatusText" Foreground="{DynamicResource SubTextBrush}" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="260"/>
					</StackPanel>
				</Grid>
			</ScrollViewer>
		</Border>

		<!-- 받기: API 키로 웹사이트에서 받아오기 -->
		<Border x:Name="ReceiveView" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" HorizontalAlignment="Left" VerticalAlignment="Top">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="220"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<TextBlock Grid.ColumnSpan="2" Text="받기" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
				<TextBlock Grid.Row="1" Text="API 키" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,4"/>
				<PasswordBox x:Name="ApiKeyBox" Grid.Row="1" Grid.Column="1" Height="24" Margin="0,0,0,4"/>
				<TextBlock Grid.Row="2" Text="코드" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,4"/>
				<TextBox x:Name="ReceiveCodeBox" Grid.Row="2" Grid.Column="1" Height="24" Margin="0,0,0,4" ToolTip="비워 두면 내 콤보 전체를 받습니다."/>
				<StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
					<Button x:Name="ReceiveButton" Width="70" Height="26" Content="받기" Click="ReceiveButton_Click"/>
					<TextBlock x:Name="ReceiveStatusText" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- 사이클 진행 화면 -->
		<Grid x:Name="CycleView" Visibility="Collapsed">

		<Grid.RenderTransform>
			<TranslateTransform x:Name="ShakeTransform"/>
		</Grid.RenderTransform>


		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="10"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>


		<!-- 현재 입력 -->
		<StackPanel Grid.Row="0">

            <TextBlock
				Text="{Binding Text}"
				FontSize="{Binding State, Converter={StaticResource CurrentSizeConverter}}"
				FontWeight="Bold"/>


			<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
				<!-- 사이클 멈춤 / 시작 -->
				<Button x:Name="PauseButton" Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="멈춤" Click="PauseButton_Click"/>

				<!-- 축소: 사이클 / 멈춤·시작 / 축소 버튼만 남깁니다 -->
				<Button x:Name="CompactButton" Style="{StaticResource IconButton}" Margin="6,0,0,0" Content="&#xE73F;" ToolTip="축소" Click="CompactButton_Click"/>

				<!-- 체크리스트 (보기 옵션) -->
				<StackPanel x:Name="OptionChecklist" Margin="12,0,0,0" VerticalAlignment="Center">
					<CheckBox x:Name="ShowNextLinesCheckBox" Content="5줄 한번에 보기" Foreground="{DynamicResource TextBrush}" FontSize="12"
							  ToolTip="현재 사이클이 끝난 뒤 이어질 4줄을 미리 보여줍니다."
							  Checked="ShowNextLinesCheckBox_Changed" Unchecked="ShowNextLinesCheckBox_Changed"/>
				</StackPanel>
			</StackPanel>
			
        </StackPanel>



		<!-- 다음 입력 리스트 -->
		<!-- 현재 줄 (하늘색 배경으로 강조) -->
		<Border x:Name="CurrentLineBorder" Grid.Row="2" Background="{DynamicResource CurrentLineBgBrush}" BorderBrush="{DynamicResource CurrentLineBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2" HorizontalAlignment="Left">
			<ItemsControl x:Name="NextInputList" ItemTemplate="{StaticResource StepTemplate}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>
		</Border>

		<!-- 다음 줄 미리보기 (5줄 한번에 보기) -->
		<ItemsControl x:Name="PreviewLines" Grid.Row="3" Visibility="Collapsed" Margin="1,2,0,0">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<!-- 한 줄 = 다음에 이어질 사이클 하나 -->
					<ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource StepTemplate}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						</ItemsControl>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		</Grid>

		</Grid>

		<!-- 사이클 파일 목록 버튼 (종료 버튼 아래) -->
		<Grid Grid.Row="1">
			<Button x:Name="CycleListButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Content="&#xE8FD;" ToolTip="사이클 목록 열기" Click="CycleListButton_Click"/>

		</Grid>

	</Grid>

    </Border>


    <!-- 사이클 파일 목록: 창 오른쪽 바깥에 창 높이만큼 슬라이드되어 나타납니다 -->
    <Popup x:Name="CycleFlyoutPopup" PlacementTarget="{Binding ElementName=RootBorder}" Placement="Right"
           AllowsTransparency="True" StaysOpen="True">
        <Grid Width="324" Height="{Binding ActualHeight, ElementName=RootBorder}" ClipToBounds="True">
		<Border x:Name="CycleFlyout" Width="320" Margin="4,0,0,0" HorizontalAlignment="Left"
				Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
			<Border.RenderTransform>
				<TranslateTransform x:Name="CycleFlyoutTransform" X="-330"/>
			</Border.RenderTransform>
			<DockPanel>
				<!-- 헤더 -->
				<Grid DockPanel.Dock="Top" Margin="4,0,4,4">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="4*"/>
						<ColumnDefinition Width="4*"/>
						<ColumnDefinition Width="3*"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="이름" Foreground="{DynamicResource SubTextBrush}" FontSize="12" FontWeight="Bold"/>
					<TextBlock Grid.Column="1" Text="사용 캐릭터" Foreground="{DynamicResource SubTextBrush}" FontSize="12" FontWeight="Bold"/>
					<TextBlock Grid.Column="2" Text="제작자" Foreground="{DynamicResource SubTextBrush}" FontSize="12" FontWeight="Bold"/>
				</Grid>
				<Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,6"/>

				<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
					<ItemsControl x:Name="CycleFileList">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border CornerRadius="6" Padding="10,7" Margin="0,0,0,4" BorderThickness="1" Cursor="Hand"
										ToolTip="클릭하면 이 사이클로 교체" MouseLeftButtonUp="CycleFileListItem_Click">
									<Border.Style>
										<Style TargetType="Border">
											<Setter Property="Background" Value="{DynamicResource CardBrush}"/>
											<Setter Property="BorderBrush" Value="Transparent"/>
											<Style.Triggers>
												<!-- 사용 중인 사이클 -->
												<DataTrigger Binding="{Binding IsActive}" Value="True">
													<Setter Property="Background" Value="{DynamicResource CurrentLineBgBrush}"/>
													<Setter Property="BorderBrush" Value="{DynamicResource CurrentLineBorderBrush}"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="4*"/>
											<ColumnDefinition Width="4*"/>
											<ColumnDefinition Width="3*"/>
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
										<TextBlock Grid.Column="1" Text="{Binding Characters}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
										<TextBlock Grid.Column="2" Text="{Binding Author}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</DockPanel>
		</Border>
        </Grid>
    </Popup>

    </Grid>

</Window>